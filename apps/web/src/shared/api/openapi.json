{
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ProfileEntryOut": {
        "properties": {
          "ci_high": {
            "title": "Ci High",
            "type": "number"
          },
          "ci_low": {
            "title": "Ci Low",
            "type": "number"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "error_key": {
            "title": "Error Key",
            "type": "string"
          },
          "family": {
            "title": "Family",
            "type": "string"
          },
          "impact": {
            "title": "Impact",
            "type": "integer"
          },
          "last_seen_at": {
            "format": "date-time",
            "title": "Last Seen At",
            "type": "string"
          },
          "n_eff": {
            "title": "N Eff",
            "type": "number"
          },
          "p_hat": {
            "title": "P Hat",
            "type": "number"
          },
          "priority": {
            "title": "Priority",
            "type": "number"
          },
          "skill": {
            "enum": [
              "sounds",
              "on_the_spot",
              "articulate"
            ],
            "title": "Skill",
            "type": "string"
          },
          "status": {
            "enum": [
              "unknown",
              "active",
              "improving",
              "watching",
              "mastered"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "error_key",
          "skill",
          "family",
          "description",
          "impact",
          "p_hat",
          "ci_low",
          "ci_high",
          "n_eff",
          "status",
          "priority",
          "last_seen_at"
        ],
        "title": "ProfileEntryOut",
        "type": "object"
      },
      "ProfileOut": {
        "properties": {
          "algo_version": {
            "title": "Algo Version",
            "type": "integer"
          },
          "as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/ProfileEntryOut"
            },
            "title": "Entries",
            "type": "array"
          },
          "taxonomy_version": {
            "title": "Taxonomy Version",
            "type": "integer"
          }
        },
        "required": [
          "as_of",
          "taxonomy_version",
          "algo_version",
          "entries"
        ],
        "title": "ProfileOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Nosolear",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/profile": {
      "get": {
        "operationId": "getProfile",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Profile"
      }
    }
  }
}
