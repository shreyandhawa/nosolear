{
  "components": {
    "schemas": {
      "ErrorOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobOut": {
        "properties": {
          "attempt_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attempt Id"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "analyze",
              "rescore"
            ],
            "title": "Kind",
            "type": "string"
          },
          "progress": {
            "title": "Progress",
            "type": "number"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "done",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepOut"
            },
            "title": "Steps",
            "type": "array"
          },
          "tries": {
            "title": "Tries",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "kind",
          "attempt_id",
          "status",
          "step",
          "progress",
          "tries",
          "steps"
        ],
        "title": "JobOut",
        "type": "object"
      },
      "ProfileEntryOut": {
        "properties": {
          "ci_high": {
            "title": "Ci High",
            "type": "number"
          },
          "ci_low": {
            "title": "Ci Low",
            "type": "number"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "error_key": {
            "title": "Error Key",
            "type": "string"
          },
          "family": {
            "title": "Family",
            "type": "string"
          },
          "impact": {
            "title": "Impact",
            "type": "integer"
          },
          "last_seen_at": {
            "format": "date-time",
            "title": "Last Seen At",
            "type": "string"
          },
          "n_eff": {
            "title": "N Eff",
            "type": "number"
          },
          "p_hat": {
            "title": "P Hat",
            "type": "number"
          },
          "priority": {
            "title": "Priority",
            "type": "number"
          },
          "skill": {
            "enum": [
              "sounds",
              "on_the_spot",
              "articulate"
            ],
            "title": "Skill",
            "type": "string"
          },
          "status": {
            "enum": [
              "unknown",
              "active",
              "improving",
              "watching",
              "mastered"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "error_key",
          "skill",
          "family",
          "description",
          "impact",
          "p_hat",
          "ci_low",
          "ci_high",
          "n_eff",
          "status",
          "priority",
          "last_seen_at"
        ],
        "title": "ProfileEntryOut",
        "type": "object"
      },
      "ProfileOut": {
        "properties": {
          "algo_version": {
            "title": "Algo Version",
            "type": "integer"
          },
          "as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/ProfileEntryOut"
            },
            "title": "Entries",
            "type": "array"
          },
          "taxonomy_version": {
            "title": "Taxonomy Version",
            "type": "integer"
          }
        },
        "required": [
          "as_of",
          "taxonomy_version",
          "algo_version",
          "entries"
        ],
        "title": "ProfileOut",
        "type": "object"
      },
      "ReadinessOut": {
        "properties": {
          "ready": {
            "title": "Ready",
            "type": "boolean"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/ReadinessRowOut"
            },
            "title": "Rows",
            "type": "array"
          }
        },
        "required": [
          "ready",
          "rows"
        ],
        "title": "ReadinessOut",
        "type": "object"
      },
      "ReadinessRowOut": {
        "properties": {
          "component": {
            "enum": [
              "azure_speech",
              "azure_capabilities",
              "anthropic",
              "transcriber",
              "phone_probe",
              "language_pack",
              "data_dir",
              "usage"
            ],
            "title": "Component",
            "type": "string"
          },
          "fix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fix"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "missing",
              "not_installed",
              "not_probed",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "component",
          "label",
          "status",
          "reason",
          "fix"
        ],
        "title": "ReadinessRowOut",
        "type": "object"
      },
      "StepOut": {
        "properties": {
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "state": {
            "enum": [
              "pending",
              "running",
              "done",
              "skipped",
              "failed",
              "blocked"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "name",
          "state",
          "error_code",
          "message"
        ],
        "title": "StepOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Nosolear",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "operationId": "getJob",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Job"
      }
    },
    "/api/jobs/{job_id}/resume": {
      "post": {
        "operationId": "resumeJob",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resume Job"
      }
    },
    "/api/profile": {
      "get": {
        "operationId": "getProfile",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Profile"
      }
    },
    "/api/readiness": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Readiness"
      }
    }
  }
}
