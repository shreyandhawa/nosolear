# Nosolear settings. Copy to .env (git-ignored) and uncomment what you change.
# Every line is optional; the default is shown. Keys stay empty here: paste them into .env only.

# Directory for the local SQLite database and recordings.
# Unset (or empty) means <repo root>/data. A relative path resolves against the repo root.
# A leading ~ is expanded to your home directory. Keep the directory under your home.
# Use a separate directory for synthetic dev data, e.g. data/dev (see `make seed`).
# NOSOLEAR_DATA_DIR=

# Address the API listens on. Loopback only (127.0.0.1, ::1 or localhost).
# NOSOLEAR_HOST=127.0.0.1
# NOSOLEAR_PORT=8000

# Browser origins allowed to call the API, comma separated. Loopback hosts only.
# NOSOLEAR_APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Azure Speech key (at least 16 characters) and the region of your Speech resource, e.g. westus2.
# NOSOLEAR_AZURE_SPEECH_KEY=
# NOSOLEAR_AZURE_SPEECH_REGION=

# Target accent for scoring and speech synthesis, and the synthesis voice.
# NOSOLEAR_AZURE_LOCALE=en-US
# NOSOLEAR_TTS_VOICE=en-US-JennyNeural

# Anthropic API key (at least 16 characters) and the Claude model the coach uses.
# NOSOLEAR_ANTHROPIC_API_KEY=
# NOSOLEAR_COACH_MODEL=claude-opus-5-5

# Speech-to-text engine: auto, mlx_whisper, faster_whisper, azure_stt or crisper_whisper.
# NOSOLEAR_TRANSCRIBER=auto
# NOSOLEAR_FASTER_WHISPER_MODEL=small.en
# NOSOLEAR_MLX_WHISPER_MODEL=whisper-large-v3-turbo

# Language pack: a directory name under content/packs/.
# NOSOLEAR_PACK=neutral

# IANA timezone for the daily plan's date. Unset means this machine's timezone.
# NOSOLEAR_TIMEZONE=

# Spending caps. Azure audio hours and TTS characters are per month; Claude tokens are per day.
# NOSOLEAR_CAP_AZURE_AUDIO_HOURS=4.5
# NOSOLEAR_CAP_AZURE_TTS_CHARS=450000
# NOSOLEAR_CAP_CLAUDE_TOKENS=100000

# Concurrent background job workers (Azure's free tier allows one request at a time).
# NOSOLEAR_JOB_WORKERS=1
